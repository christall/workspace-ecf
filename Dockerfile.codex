# Dockerfile.codex — Contexte d'exécution Codex CLI (OpenAI)
# Image basée sur node:22-slim (Debian 12 Bookworm) — même base que Dockerfile.claude-code,
# pour disposer des mêmes outils de travail sur le code du workspace (PHP, Python, SQL, SSH).
# Build : docker build -t mon-codex -f Dockerfile.codex .
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    git default-mysql-client \
    python3 python3-pip \
    sqlite3 \
    openssh-client \
    php-cli \
    locales \
    procps \
    && locale-gen fr_FR.UTF-8 \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex pnpm
ENV PNPM_STORE_DIR=/pnpm-store
ENV npm_config_cache=/root/.npm
ENV LANG=fr_FR.UTF-8
ENV LC_ALL=fr_FR.UTF-8
WORKDIR /workspace
CMD ["bash"]
