# Dockerfile.opencode — Contexte d'exécution OpenCode CLI (multi-modèles)
# Image basée sur node:22-slim (Debian 12 Bookworm) — même base que Dockerfile.codex
# Build : docker build -t mon-opencode -f Dockerfile.opencode .

FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git default-mysql-client \
    python3 python3-pip \
    sqlite3 \
    openssh-client \
    php-cli \
    locales \
    procps \
    && locale-gen fr_FR.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Installation d'OpenCode CLI (selon version : @opencode/cli pour v2 ou opencode-ai)
RUN npm install -g @opencode/cli pnpm

ENV PNPM_STORE_DIR=/pnpm-store
ENV npm_config_cache=/root/.npm
ENV LANG=fr_FR.UTF-8
ENV LC_ALL=fr_FR.UTF-8

WORKDIR /workspace
CMD ["bash"]